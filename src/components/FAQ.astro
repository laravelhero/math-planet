---
import { faqs } from '../data/site';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
---

<section id="faq" class="section-pad">
  <div class="container-page">
    <SectionHeading
      eyebrow="সাধারণ জিজ্ঞাসা"
      eyebrowIcon="bulb"
      title="প্রায়শই জিজ্ঞাসিত প্রশ্ন"
      subtitle="ভর্তি, ক্লাস ও কোর্স সম্পর্কিত সাধারণ প্রশ্নের উত্তর এখানে পাবেন।"
    />

    <div class="reveal mx-auto max-w-3xl space-y-3" x-data="{ open: 0 }">
      {
        faqs.map((faq, i) => (
          <div class="overflow-hidden rounded-2xl border border-navy-100 bg-white shadow-sm transition-shadow hover:shadow-md">
            <h3>
              <button
                @click={`open = open === ${i} ? null : ${i}`}
                class="flex w-full items-center justify-between gap-4 px-5 py-4 text-right text-base font-semibold text-navy-800 sm:px-6"
                :aria-expanded={`open === ${i}`}
              >
                <span>{faq.q}</span>
                <span
                  class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-navy-50 text-navy-700 transition-transform duration-300"
                  :class={`open === ${i} ? 'rotate-180 bg-navy-700 text-white' : ''`}
                >
                  <Icon name="chevron" class="h-5 w-5" />
                </span>
              </button>
            </h3>
            <div
              x-show={`open === ${i}`}
              x-cloak={i !== 0}
              x-transition:enter="transition ease-out duration-300"
              x-transition:enter-start="opacity-0 -translate-y-2"
              x-transition:enter-end="opacity-100 translate-y-0"
            >
              <p class="px-5 pb-5 text-sm leading-relaxed text-navy-600 sm:px-6">{faq.a}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  [x-cloak] {
    display: none !important;
  }
</style>
