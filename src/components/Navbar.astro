---
import { site, teacher, navLinks } from '../data/site';
import Icon from './Icon.astro';
---

<header
  x-data="{ open: false, scrolled: false }"
  @scroll.window="scrolled = window.scrollY > 20"
  :class="scrolled ? 'bg-white/95 shadow-md backdrop-blur' : 'bg-white/80 backdrop-blur'"
  class="fixed inset-x-0 top-0 z-50 border-b border-navy-100 transition-all duration-300"
>
  <nav class="container-page flex h-16 items-center justify-between lg:h-20" aria-label="প্রধান মেনু">
    <!-- Brand -->
    <a href="#top" class="flex items-center gap-2.5">
      <span class="grid h-10 w-10 place-items-center rounded-xl bg-gradient-to-br from-navy-600 to-navy-800 text-gold-400 shadow-lg">
        <Icon name="math" class="h-6 w-6" />
      </span>
      <span class="flex flex-col leading-tight">
        <span class="text-lg font-bold text-navy-800">{site.name}</span>
        <span class="text-[11px] font-medium tracking-wide text-navy-400">{site.brandEn}</span>
      </span>
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-1 lg:flex">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-lg px-3 py-2 text-sm font-medium text-navy-700 transition-colors hover:bg-navy-50 hover:text-navy-900"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- CTA + burger -->
    <div class="flex items-center gap-2">
      <a href={`tel:+88${teacher.mobile}`} class="btn-gold hidden px-4 py-2.5 text-sm sm:inline-flex">
        <Icon name="phone" class="h-4 w-4" />
        কল করুন
      </a>
      <button
        @click="open = !open"
        class="grid h-10 w-10 place-items-center rounded-lg text-navy-700 hover:bg-navy-50 lg:hidden"
        :aria-expanded="open"
        aria-label="মেনু খুলুন"
      >
        <Icon name="menu" x-show="!open" class="h-6 w-6" />
        <Icon name="close" x-show="open" x-cloak class="h-6 w-6" />
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div
    x-show="open"
    x-cloak
    x-transition.opacity
    @click.outside="open = false"
    class="border-t border-navy-100 bg-white lg:hidden"
  >
    <ul class="container-page flex flex-col py-3">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              @click="open = false"
              class="block rounded-lg px-3 py-3 text-base font-medium text-navy-700 hover:bg-navy-50"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="mt-2 px-3">
        <a href={`tel:+88${teacher.mobile}`} @click="open = false" class="btn-gold w-full">
          <Icon name="phone" class="h-5 w-5" />
          এখনই কল করুন
        </a>
      </li>
    </ul>
  </div>
</header>

<style>
  [x-cloak] {
    display: none !important;
  }
</style>
