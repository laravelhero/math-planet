---
import { Image } from 'astro:assets';
import { site, teacher, stats } from '../data/site';
import Icon from './Icon.astro';
import samirPhoto from '../assets/hasan-uzzaman-samir.jpg';
---

<section
  id="top"
  class="relative overflow-hidden bg-gradient-to-br from-navy-900 via-navy-800 to-navy-700 pt-28 pb-16 text-white lg:pt-36 lg:pb-24"
>
  <!-- decorative blobs -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -right-24 -top-24 h-96 w-96 rounded-full bg-gold-500/10 blur-3xl"></div>
    <div class="absolute -bottom-32 -left-20 h-96 w-96 rounded-full bg-emerald-500/10 blur-3xl"></div>
    <div class="absolute inset-0 opacity-[0.04] [background-image:radial-gradient(circle,white_1px,transparent_1px)] [background-size:28px_28px]"></div>
  </div>

  <div class="container-page relative grid items-center gap-12 lg:grid-cols-2">
    <!-- Copy -->
    <div class="reveal text-center lg:text-right">
      <span class="eyebrow bg-white/10 text-gold-300 ring-1 ring-white/15">
        <Icon name="star" class="h-4 w-4" />
        {site.name} — উচ্চতর গণিত কোচিং
      </span>

      <h1 class="mt-6 text-3xl font-bold leading-tight sm:text-4xl lg:text-5xl">
        <span class="bg-gradient-to-l from-gold-300 to-gold-500 bg-clip-text text-transparent">
          {site.tagline}
        </span>
      </h1>

      <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-navy-100 sm:text-lg lg:mr-0">
        {site.description.split('।')[0]}।
      </p>

      <!-- Qualification highlights -->
      <ul class="mt-6 flex flex-wrap justify-center gap-2 lg:justify-end">
        {
          teacher.roles.map((role) => (
            <li class="rounded-full bg-white/10 px-3 py-1.5 text-sm font-medium text-navy-50 ring-1 ring-white/15">
              {role}
            </li>
          ))
        }
      </ul>

      <!-- CTAs -->
      <div class="mt-8 flex flex-col flex-wrap justify-center gap-3 sm:flex-row lg:justify-end">
        <a href="#admission" class="btn-gold">
          <Icon name="check" class="h-5 w-5" />
          ভর্তি হতে চাই
        </a>
        <a href="#contact" class="btn bg-white/10 text-white ring-1 ring-white/25 hover:bg-white/20">
          যোগাযোগ করুন
        </a>
        <a href={`tel:+88${teacher.mobile}`} class="btn-emerald">
          <Icon name="phone" class="h-5 w-5" />
          এখনই কল করুন
        </a>
      </div>
    </div>

    <!-- Photo + floating card -->
    <div class="reveal relative mx-auto w-full max-w-md">
      <div class="relative rounded-[2rem] bg-gradient-to-br from-gold-400/20 to-emerald-400/20 p-2 ring-1 ring-white/20">
        <div class="aspect-[4/5] overflow-hidden rounded-[1.6rem] bg-gradient-to-b from-navy-700 to-navy-900">
          <Image
            src={samirPhoto}
            alt={`${teacher.name} — ${teacher.roles[1]}`}
            widths={[400, 600, 800]}
            sizes="(max-width: 768px) 90vw, 28rem"
            loading="eager"
            class="h-full w-full object-cover object-top"
          />
        </div>
      </div>

      <!-- Floating credential chip -->
      <div class="absolute -left-3 top-8 hidden rounded-2xl bg-white p-3 text-navy-900 shadow-xl sm:block">
        <div class="flex items-center gap-2">
          <span class="grid h-10 w-10 place-items-center rounded-xl bg-gold-100 text-gold-600">
            <Icon name="badge" class="h-6 w-6" />
          </span>
          <div class="leading-tight">
            <p class="text-sm font-bold">৩৬তম বিসিএস</p>
            <p class="text-xs text-navy-500">শিক্ষা ক্যাডার</p>
          </div>
        </div>
      </div>
      <div class="absolute -bottom-4 -right-2 hidden rounded-2xl bg-white p-3 text-navy-900 shadow-xl sm:block">
        <div class="flex items-center gap-2">
          <span class="grid h-10 w-10 place-items-center rounded-xl bg-emerald-100 text-emerald-600">
            <Icon name="university" class="h-6 w-6" />
          </span>
          <div class="leading-tight">
            <p class="text-sm font-bold">ঢাকা বিশ্ববিদ্যালয়</p>
            <p class="text-xs text-navy-500">স্নাতকোত্তর, গণিত</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Statistics cards -->
  <div class="container-page relative mt-14">
    <dl class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {
        stats.map((s) => (
          <div class="reveal rounded-2xl bg-white/10 p-4 text-center ring-1 ring-white/15 backdrop-blur transition hover:bg-white/15 sm:p-5">
            <span class="mx-auto grid h-11 w-11 place-items-center rounded-xl bg-gold-500/20 text-gold-300">
              <Icon name={s.icon} class="h-6 w-6" />
            </span>
            <dt class="mt-3 text-lg font-bold text-white sm:text-xl">{s.value}</dt>
            <dd class="mt-0.5 text-xs text-navy-100 sm:text-sm">{s.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
