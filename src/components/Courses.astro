---
import { courses, teacher } from '../data/site';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
---

<section id="courses" class="section-pad bg-white">
  <div class="container-page">
    <SectionHeading
      eyebrow="কোর্সসমূহ"
      eyebrowIcon="book"
      title="HSC উচ্চতর গণিত কোর্স"
      subtitle="HSC ১ম ও ২য় বর্ষের সম্পূর্ণ সিলেবাসভিত্তিক, অধ্যায়ভিত্তিক প্রস্তুতি কোর্স।"
    />

    <div class="grid gap-6 lg:grid-cols-2">
      {
        courses.map((course, i) => (
          <article
            class="reveal group relative flex flex-col overflow-hidden rounded-3xl border border-navy-100 bg-gradient-to-b from-white to-navy-50/50 shadow-sm transition-all duration-300 hover:shadow-xl"
            style={`transition-delay:${i * 100}ms`}
          >
            {/* header */}
            <div class="relative overflow-hidden bg-gradient-to-br from-navy-700 to-navy-900 p-6 text-white">
              <div class="pointer-events-none absolute -right-10 -top-10 h-32 w-32 rounded-full bg-gold-500/15 blur-2xl" />
              <div class="flex items-start justify-between gap-3">
                <div>
                  <span class="text-sm font-medium text-gold-300">{course.level}</span>
                  <h3 class="mt-1 text-2xl font-bold">{course.title}</h3>
                </div>
                <span class="shrink-0 animate-pulse rounded-full bg-emerald-500 px-3 py-1.5 text-xs font-bold text-white shadow-lg">
                  ভর্তি চলছে
                </span>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-navy-100">{course.summary}</p>
            </div>

            {/* topics */}
            <div class="flex flex-1 flex-col p-6">
              <p class="mb-3 text-sm font-semibold text-navy-700">যা যা থাকছে:</p>
              <ul class="grid grid-cols-2 gap-2.5">
                {course.topics.map((t) => (
                  <li class="flex items-center gap-2 text-sm text-navy-700">
                    <Icon name="check" class="h-4 w-4 shrink-0 text-emerald-600" />
                    {t}
                  </li>
                ))}
              </ul>

              <div class="mt-6 flex flex-col gap-2.5 sm:flex-row">
                <a href="#admission" class="btn-primary flex-1 py-2.5 text-sm">
                  বিস্তারিত দেখুন
                  <Icon name="arrow" class="h-4 w-4" />
                </a>
                <a
                  href={`tel:+88${teacher.mobile}`}
                  class="btn-outline flex-1 py-2.5 text-sm"
                >
                  <Icon name="phone" class="h-4 w-4" />
                  যোগাযোগ করুন
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
