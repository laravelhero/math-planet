---
import { teacher } from '../data/site';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

const waText = encodeURIComponent('আসসালামু আলাইকুম, আমি উচ্চতর গণিত কোর্স সম্পর্কে জানতে চাই।');
---

<section id="contact" class="section-pad bg-navy-50/50">
  <div class="container-page">
    <SectionHeading
      eyebrow="যোগাযোগ"
      eyebrowIcon="phone"
      title="যোগাযোগ করুন"
      subtitle="যেকোনো প্রশ্ন বা ভর্তি সংক্রান্ত তথ্যের জন্য সরাসরি যোগাযোগ করুন।"
    />

    <div class="mx-auto grid max-w-4xl gap-4 sm:grid-cols-2">
      <!-- Phone -->
      <a
        href={`tel:+88${teacher.mobile}`}
        class="reveal group flex items-center gap-4 rounded-2xl border border-navy-100 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
      >
        <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-navy-700 text-white transition group-hover:scale-110">
          <Icon name="phone" class="h-7 w-7" />
        </span>
        <div>
          <p class="text-sm text-navy-500">মোবাইল</p>
          <p class="text-lg font-bold text-navy-800">{teacher.mobileDisplay}</p>
        </div>
      </a>

      <!-- Email -->
      <a
        href={`mailto:${teacher.email}`}
        class="reveal group flex items-center gap-4 rounded-2xl border border-navy-100 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
      >
        <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-gold-500 text-navy-900 transition group-hover:scale-110">
          <Icon name="mail" class="h-7 w-7" />
        </span>
        <div class="min-w-0">
          <p class="text-sm text-navy-500">ইমেইল</p>
          <p class="truncate text-lg font-bold text-navy-800">{teacher.email}</p>
        </div>
      </a>
    </div>

    <!-- CTA buttons -->
    <div class="reveal mx-auto mt-6 flex max-w-4xl flex-col gap-3 sm:flex-row">
      <a
        href={`https://wa.me/${teacher.whatsapp}?text=${waText}`}
        target="_blank"
        rel="noopener"
        class="btn-emerald flex-1"
      >
        <Icon name="whatsapp" class="h-5 w-5" />
        WhatsApp এ মেসেজ করুন
      </a>
      <a href={`tel:+88${teacher.mobile}`} class="btn-primary flex-1">
        <Icon name="phone" class="h-5 w-5" />
        এখনই কল করুন
      </a>
    </div>
  </div>
</section>
